{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/sandbox.ts"
  ],
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "stryker-report/mutation/incremental.json",
  "concurrency": 8,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "ignoreStatic": true,
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 59
  },
  "reporters": ["html", "clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "stryker-report/mutation/report.json"
  },
  "tempDirName": "stryker-tmp",
  "cleanTempDir": true
}
