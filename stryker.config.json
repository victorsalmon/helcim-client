{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/sandbox.ts"
  ],
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 70
  },
  "concurrency": 2,
  "timeoutMs": 60000
}
