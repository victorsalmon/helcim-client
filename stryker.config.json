{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["src/**/*.ts", "!src/index.ts", "!src/sandbox.ts"],
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "stryker-report/mutation/incremental.json",
  "concurrency": 8,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "ignoreStatic": true,
  "ignoreStatic_comment": "Accepted: the only static mutants are the src/config.ts base-URL string literals and the loopback-hostname set. config.test.ts asserts their exact values, but static initializers have no per-test coverage attribution, so Stryker would re-run the whole suite per mutant for no extra signal. Revisit if a new static constant ships.",
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 59
  },
  "reporters": ["html", "clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "stryker-report/mutation/report.json"
  },
  "tempDirName": "stryker-tmp",
  "cleanTempDir": true
}
